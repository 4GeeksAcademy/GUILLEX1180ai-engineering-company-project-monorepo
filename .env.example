# --- JWT Configuration (AUTH-01) ---
# Minimum 32 bytes. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="change-me-to-a-secret-with-at-least-32-bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Password Reset (AUTH-03) ---
# Resend API key for transactional emails. Get one at https://resend.com
# Leave empty to skip email delivery (reset flow will log requests instead).
RESEND_API_KEY=""

# Sender address for password-reset emails (must be verified in Resend).
EMAIL_FROM="onboarding@resend.dev"

# Frontend URL where the password-reset link points (without trailing slash).
FRONTEND_URL="http://localhost:3001"

# How many minutes the reset token is valid (15–60).
RESET_TOKEN_EXPIRE_MINUTES=30
